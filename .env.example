# Supabase (PostgreSQL)
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-1-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-1-us-east-1.pooler.supabase.com:5432/postgres"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"  # Needed for scripts/create-test-user.ts (E2E seed)

# Auth
INVITE_ONLY=true

# Base URL — used for magic link redirects and pass images
# Dev: http://localhost:3000 | Prod: https://fidelity.zivelo.dev
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Supabase Storage — bucket name for pass images and logos (default: "pass-images")
SUPABASE_STORAGE_BUCKET=pass-images

# Google Wallet Passes
# Set to "true" to skip service account validation (generates unsigned JWTs for testing)
GOOGLE_WALLET_DEV_MODE=false
# From Google Pay & Wallet Console → Issuer ID
GOOGLE_WALLET_ISSUER_ID="YOUR_ISSUER_ID"
# Service account email (from GCP service account JSON key)
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL="your-service-account@project.iam.gserviceaccount.com"
# Preferred: paste the full service account JSON as a single-line string (set in your secrets manager / CI env)
# GOOGLE_WALLET_SERVICE_ACCOUNT_KEY_JSON='{"type":"service_account","private_key":"-----BEGIN RSA PRIVATE KEY-----\n..."}'
# Fallback (dev only): relative path inside certificates/ — NEVER commit the JSON file to git
GOOGLE_WALLET_SERVICE_ACCOUNT_KEY_FILE="certificates/google-service-account.json"
# Allowed origins for the save button (comma-separated)
GOOGLE_WALLET_ORIGINS="http://localhost:3000,https://localhost:3000"

# SMTP — transactional email (scripts/send-invite.ts)
# Zoho Mail: host=smtp.zoho.com, port=465 (SSL) o 587 (TLS)
SMTP_HOST="smtp.zoho.com"
SMTP_PORT="465"
SMTP_USER="tu@dominio.com"
SMTP_PASS="tu_contrasena_zoho"

# Google OAuth (configured in Supabase Dashboard, stored here for reference)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# Apple Wallet Passes
# Set to "true" to skip certificate validation (passes work in iOS Simulator only)
APPLE_WALLET_DEV_MODE=false
APPLE_PASS_TYPE_IDENTIFIER="pass.com.koda.fidelity"
APPLE_TEAM_IDENTIFIER="YOUR_TEAM_ID"
# Paths to signing certificates in certificates/ directory
# APPLE_PASS_SIGNER_CERT=certificates/signerCert.pem
# APPLE_PASS_SIGNER_KEY=certificates/signerKey.pem
# APPLE_WWDR_CERT=certificates/wwdr.pem
APPLE_PASS_CERT_PASSWORD=""
# Auth token for push updates (generate a random UUID)
APPLE_PASS_AUTH_TOKEN=""
# Base URL for pass web service (push update callbacks)
APPLE_PASS_WEBSERVICE_URL=""
