# --- Generated pass images (build artifacts) ---
public/passes/*.png

# --- Playwright ---
playwright-report/
test-results/
e2e-results.txt

# Capturas de la verificación de diseño: se regeneran con
# npx playwright test --config playwright.design.config.ts
docs/design/verificadores/capturas/

# Motor del documento de temas: es de terceros y no se versiona.
# Para verlo completo, copiar support.js junto a loyalty-card-themes.dc.html
docs/design/support.js

# Config local de Playwright para correr en otro puerto. No se versiona.
playwright.local.config.ts

# iCloud deja copias numeradas al sincronizar («cola-de-borrador 2.ts»). Nunca
# son fuente. La regla cubre cualquier extensión a propósito: la primera versión
# solo miraba .ts y .tsx, y por eso llegaron a dev nueve .md y nueve .sql dentro
# de una carpeta de migración de Prisma.
* [0-9]*.*
